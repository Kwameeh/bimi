# Client configuration only. Copy to .env.local and use your own Convex deployment.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
EXPO_PUBLIC_BIMI_INSTANCE=main

# Optional Expo/EAS project identity (used by app.config.ts).
BIMI_EXPO_OWNER=
BIMI_EAS_PROJECT_ID=
# Optional application IDs for your own distribution.
BIMI_ANDROID_PACKAGE=
BIMI_IOS_BUNDLE_IDENTIFIER=
