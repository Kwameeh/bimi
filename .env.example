# Client configuration only. Copy to .env.local.
#
# Option A: Convex Cloud (Managed Free Tier / Pro)
# EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
#
# Option B: Self-Hosted Convex (Docker, VPS, or local backend)
# EXPO_PUBLIC_CONVEX_URL=https://api.convex.example.com (or http://localhost:3210)
# EXPO_PUBLIC_CONVEX_SITE_URL=https://site.convex.example.com (or http://localhost:3211)
# CONVEX_SELF_HOSTED_URL=https://api.convex.example.com
# CONVEX_SELF_HOSTED_ADMIN_KEY=convex-self-hosted|your-admin-key
#
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
EXPO_PUBLIC_BIMI_INSTANCE=main

# Optional Expo/EAS project identity (used by app.config.ts).
BIMI_EXPO_OWNER=
BIMI_EAS_PROJECT_ID=
# Optional application IDs for your own distribution.
BIMI_ANDROID_PACKAGE=
BIMI_IOS_BUNDLE_IDENTIFIER=
