{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://api.convex.twumdufe.com",
        "EXPO_PUBLIC_CONVEX_SITE_URL": "https://site.convex.twumdufe.com",
        "EXPO_PUBLIC_BIMI_INSTANCE": "kwameeh"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://api.convex.twumdufe.com",
        "EXPO_PUBLIC_CONVEX_SITE_URL": "https://site.convex.twumdufe.com",
        "EXPO_PUBLIC_BIMI_INSTANCE": "kwameeh"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://api.convex.twumdufe.com",
        "EXPO_PUBLIC_CONVEX_SITE_URL": "https://site.convex.twumdufe.com",
        "EXPO_PUBLIC_BIMI_INSTANCE": "kwameeh"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
