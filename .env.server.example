# Reference only: set these on your Convex backend, not in the Expo client.
# See docs/ai-providers.md. Blank optional entries can be omitted.
EVOLUTION_API_BASE_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# Text provider: cloudflare | openai | anthropic | google | groq | deepseek | openai-compatible
BIMI_AI_PROVIDER=cloudflare

# Global model override (overrides all background text tasks across the selected provider):
BIMI_AI_MODEL=

# Task-specific model overrides (optional — defaults to *_MODEL or BIMI_AI_MODEL):
BIMI_AI_REPLY_MODEL=       # WhatsApp auto-replies & draft proposals
BIMI_AI_SUMMARY_MODEL=     # Chat summaries, group digests & daily briefings
BIMI_AI_JSON_MODEL=        # Intent classification, memory extraction & contact goals
BIMI_AI_TEXT_MODEL=        # Fallback general text operations

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKERS_AI_ASSISTANT_MODEL=
CLOUDFLARE_WORKERS_AI_ASSISTANT_MODELS=
CLOUDFLARE_WORKERS_AI_CHAT_MODEL=
CLOUDFLARE_WORKERS_AI_SUMMARY_MODEL=
CLOUDFLARE_WORKERS_AI_VISION_MODEL=
CLOUDFLARE_WORKERS_AI_VISION_STRUCTURED_MODEL=
CLOUDFLARE_WORKERS_AI_TTS_MODEL=

# Choose current model IDs from each provider's catalog.
# *_MODEL is the default; optional *_MODELS adds comma-separated picker choices.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODELS=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=
GOOGLE_MODELS=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_MODELS=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_MODELS=
OPENAI_COMPATIBLE_STRUCTURED_OUTPUTS=false

# Vision is selected independently; a text-only model cannot process images.
BIMI_VISION_PROVIDER=cloudflare
BIMI_VISION_MODEL=

# Transcription: assemblyai | cloudflare | openai | groq | openai-compatible
BIMI_TRANSCRIPTION_PROVIDER=assemblyai
BIMI_TRANSCRIPTION_MODEL=
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODELS=universal-2
OPENAI_COMPATIBLE_TRANSCRIPTION_MODEL=
